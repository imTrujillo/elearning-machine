RABBITMQ_PASSWORD=cambia_esta_password

WORDPRESS_URL=http://wordpress:80
WORDPRESS_USERNAME=admin
WORDPRESS_PASSWORD=tu_application_password_wp

WOO_CONSUMER_KEY=ck_xxx
WOO_CONSUMER_SECRET=cs_xxx

WP_MYSQL_ROOT_PASSWORD=wordpress_root
WP_MYSQL_USER=wordpress
WP_MYSQL_PASSWORD=wordpress
