# Copia a .env para Docker Compose

# --- IntelliJ: ver .env.intellij.example (localhost + docker compose up -d sin --profile app) ---

MYSQL_URL= url
MYSQL_USERNAME=root
MYSQL_PASSWORD=contrasena
MYSQL_ROOT_PASSWORD=contrasena
MYSQL_DATABASE=learning_engine

REDIS_HOST=redis
REDIS_PORT=port
REDIS_PASSWORD=contrasena

RABBITMQ_HOST=host
RABBITMQ_PORT=port
